{% doc %}
  @prompt
    Create a section with heading and text option widh bullet points and all other option and in the section create  3-4 columns that has heading and content with all the advancved options. Section widh should be adustable in pixels, there must be an option of selecting the heading type like h2, h2, h4 and all and also option of section padding, column padding, font size for section and column
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-columns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-columns-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
  }

  .ai-content-columns-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-content-columns-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-content-columns-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.text_line_height }};
  }

  .ai-content-columns-text-{{ ai_gen_id }} ul {
    list-style-type: {{ block.settings.bullet_style }};
    padding-left: {{ block.settings.bullet_indent }}px;
    margin: 0;
  }

  .ai-content-columns-text-{{ ai_gen_id }} li {
    margin-bottom: {{ block.settings.bullet_spacing }}px;
  }

  .ai-content-columns-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.columns_top_spacing }}px;
  }

  .ai-content-column-{{ ai_gen_id }} {
    padding: {{ block.settings.column_padding_top }}px {{ block.settings.column_padding_horizontal }}px {{ block.settings.column_padding_bottom }}px;
    background-color: {{ block.settings.column_background_color }};
    border-radius: {{ block.settings.column_border_radius }}px;
    border: {{ block.settings.column_border_width }}px solid {{ block.settings.column_border_color }};
    text-align: {{ block.settings.column_text_alignment }};
  }

  .ai-content-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_heading_size }}px;
    color: {{ block.settings.column_heading_color }};
    margin: 0 0 {{ block.settings.column_heading_spacing }}px;
    font-weight: {{ block.settings.column_heading_weight }};
  }

  .ai-content-column-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_text_size }}px;
    color: {{ block.settings.column_text_color }};
    line-height: {{ block.settings.column_text_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-content-columns-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-content-columns-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-content-columns-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-content-columns-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-content-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-content-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-columns-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="ai-content-columns-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          {% case block.settings.heading_tag %}
            {% when 'h1' %}
              <h1 class="ai-content-columns-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
            {% when 'h2' %}
              <h2 class="ai-content-columns-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% when 'h3' %}
              <h3 class="ai-content-columns-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
            {% when 'h4' %}
