{% doc %}
  @prompt
    Create a section with heading, sub-heading and text and a compration table  4-6 columns and 10-12 rows. Section with should be adjustable in pixels, in table there should be an option to heading, font-size, bold, not bold and all other advanced option like text allign etc. I also want a option to remove or add rows and columns
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-comparison-table__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: 30px;
  }

  .ai-comparison-table__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px 0;
    {% if block.settings.heading_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 10px 0;
    {% if block.settings.subheading_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    {% if block.settings.text_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} th,
  .ai-comparison-table__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    text-align: {{ block.settings.cell_alignment }};
    vertical-align: middle;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_font_size }}px;
    {% if block.settings.header_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_background }};
    color: {{ block.settings.cell_text_color }};
    font-size: {{ block.settings.cell_font_size }}px;
    {% if block.settings.cell_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tr:nth-child(even) td {
    {% if block.settings.enable_striped_rows %}
      background-color: {{ block.settings.striped_row_background }};
    {% endif %}
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tr:hover td {
    {% if block.settings.enable_row_hover %}
      background-color: {{ block.settings.row_hover_background }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: 20px 10px;
    }

    .ai-comparison-table__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-comparison-table__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-comparison-table__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }

    .ai-comparison-table__table-{{ ai_gen_id }} th,
    .ai-comparison-table__table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.cell_font_size | times: 0.8 }}px;
    }

    .ai-comparison-table__table-{{ ai_gen_id }} th {
      font-size: {{ block.settings.header_font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.description != blank %}
    <div class="ai-comparison-table__header-{{ ai_gen_id }}">
