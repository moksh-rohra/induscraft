{% doc %}
  @prompt
    Create a section with adjustable widh in pixel and has heading, sub-heading and content and has 3-5 multi column with heading and text with bullet points and all other advanced features. The section must have a padding option for top and bottom, I also want the option of adjust font size for all the headings, text, sub heading for section and multucolumns also
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-column-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-multi-column-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multi-column-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-multi-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.2;
  }

  .ai-multi-column-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_margin }}px;
    font-weight: {{ block.settings.subheading_weight }};
    line-height: 1.4;
  }

  .ai-multi-column-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-multi-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .ai-multi-column-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    padding: {{ block.settings.column_padding }}px;
    border-radius: {{ block.settings.column_border_radius }}px;
    {% if block.settings.show_column_border %}
      border: {{ block.settings.column_border_width }}px solid {{ block.settings.column_border_color }};
    {% endif %}
    {% if block.settings.show_column_shadow %}
      box-shadow: 0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-multi-column-item-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift }}px);
      {% if block.settings.show_column_shadow %}
        box-shadow: 0 {{ block.settings.shadow_offset_y | plus: 4 }}px {{ block.settings.shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | plus: 0.1 }});
      {% endif %}
    }
  {% endif %}

  .ai-multi-column-item-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_heading_size }}px;
    color: {{ block.settings.column_heading_color }};
    margin: 0 0 {{ block.settings.column_heading_margin }}px;
    font-weight: {{ block.settings.column_heading_weight }};
    line-height: 1.3;
  }

  .ai-multi-column-item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_text_size }}px;
    color: {{ block.settings.column_text_color }};
    margin: 0 0 {{ block.settings.bullet_spacing }}px;
    line-height: 1.5;
  }

  .ai-multi-column-bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-multi-column-bullets-{{ ai_gen_id }} li {
    font-size: {{ block.settings.bullet_text_size }}px;
    color: {{ block.settings.bullet_text_color }};
    margin-bottom: {{ block.settings.bullet_item_spacing }}px;
    padding-left: {{ block.settings.bullet_indent }}px;
    position: relative;
    line-height: 1.6;
  }

  .ai-multi-column-bullets-{{ ai_gen_id }} li:before {
    content: "{{ block.settings.bullet_style }}";
    position: absolute;
    left: 0;
    color: {{ block.settings.bullet_color }};
    font-weight: bold;
  }

  @media screen and (max-width: 989px) {
    .ai-multi-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-multi-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_tablet }}px;
    }

    .ai-multi-column-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_tablet }}px;
    }

    .ai-multi-column-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.content_size_tablet }}px;
    }

    .ai-multi-column-item-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_heading_size_tablet }}px;
    }

    .ai-multi-column-item-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_text_size_tablet }}px;
    }

    .ai-multi-column-bullets-{{ ai_gen_id }} li {
      font-size: {{ block.settings.bullet_text_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-multi-column-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-multi-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-multi-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-multi-column-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-multi-column-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.content_size_mobile }}px;
    }

    .ai-multi-column-item-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding_mobile }}px;
    }

    .ai-multi-column-item-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_heading_size_mobile }}px;
    }

    .ai-multi-column-item-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_text_size_mobile }}px;
    }

    .ai-multi-column-bullets-{{ ai_gen_id }} li {
      font-size: {{ block.settings.bullet_text_size_mobile }}px;
    }
  }
{% endstyle %}

<multi-column-section-{{ ai_gen_id }} class="ai-multi-column-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multi-column-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.content != blank %}
      <div class="ai-multi-column-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        
        {% if block.settings.subheading != blank %}
          <div class="ai-multi-column-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
        
        {% if block.settings.content != blank %}
          <div class="ai-multi-column-content-{{ ai_gen_id }}">{{ block.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-multi-column-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_heading_key = 'column_' | append: i | append: '_heading'
          assign column_text_key = 'column_' | append: i | append: '_text'
          assign column_bullet_1_key = 'column_' | append: i | append: '_bullet_1'
          assign column_bullet_2_key = 'column_' | append: i | append: '_bullet_2'
          assign column_bullet_3_key = 'column_' | append: i | append: '_bullet_3'
          assign column_bullet_4_key = 'column_' | append: i | append: '_bullet_4'
          assign column_bullet_5_key = 'column_' | append: i | append: '_bullet_5'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_heading = block.settings[column_heading_key]
          assign column_text = block.settings[column_text_key]
          assign column_bullet_1 = block.settings[column_bullet_1_key]
          assign column_bullet_2 = block.settings[column_bullet_2_key]
          assign column_bullet_3 = block.settings[column_bullet_3_key]
          assign column_bullet_4 = block.settings[column_bullet_4_key]
          assign column_bullet_5 = block.settings[column_bullet_5_key]
        %}

        {% if column_enabled %}
          <div class="ai-multi-column-item-{{ ai_gen_id }}">
            {% if column_heading != blank %}
              <h3 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-multi-column-item-text-{{ ai_gen_id }}">{{ column_text }}</div>
            {% endif %}

            {% if column_bullet_1 != blank or column_bullet_2 != blank or column_bullet_3 != blank or column_bullet_4 != blank or column_bullet_5 != blank %}
              <ul class="ai-multi-column-bullets-{{ ai_gen_id }}">
                {% if column_bullet_1 != blank %}
                  <li>{{ column_bullet_1 }}</li>
                {% endif %}
                {% if column_bullet_2 != blank %}
                  <li>{{ column_bullet_2 }}</li>
                {% endif %}
                {% if column_bullet_3 != blank %}
                  <li>{{ column_bullet_3 }}</li>
                {% endif %}
                {% if column_bullet_4 != blank %}
                  <li>{{ column_bullet_4 }}</li>
                {% endif %}
                {% if column_bullet_5 != blank %}
                  <li>{{ column_bullet_5 }}</li>
                {% endif %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</multi-column-section-{{ ai_gen_id }}>

<script>
  (function() {
    class MultiColumnSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('multi-column-section-{{ ai_gen_id }}', MultiColumnSection{{ ai_gen_id }});
  })();
</script>

