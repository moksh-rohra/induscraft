{% doc %}
  @prompt
    Create a section with heading, sub-heading and text and a compration table  4-6 columns and 10-12 rows. Section with should be adjustable in pixels, in table there should be an option to heading, font-size, bold, not bold and all other advanced option like text allign etc. In the main section I want another option of heading and content, in heading there must be an option of selecting the heading type like h2, h2 etc
    
    , No, I want heading, text, heading, text and then table
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-comparison-table__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
  }

  .ai-comparison-table__content-section-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-comparison-table__heading-1-{{ ai_gen_id }} {
    color: {{ block.settings.heading_1_color }};
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_1_font_size }}px;
    text-align: {{ block.settings.heading_1_text_align }};
    {% if block.settings.heading_1_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__text-1-{{ ai_gen_id }} {
    color: {{ block.settings.text_1_color }};
    margin: 0 0 32px 0;
    font-size: {{ block.settings.text_1_font_size }}px;
    text-align: {{ block.settings.text_1_text_align }};
    {% if block.settings.text_1_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__heading-2-{{ ai_gen_id }} {
    color: {{ block.settings.heading_2_color }};
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_2_font_size }}px;
    text-align: {{ block.settings.heading_2_text_align }};
    {% if block.settings.heading_2_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__text-2-{{ ai_gen_id }} {
    color: {{ block.settings.text_2_color }};
    margin: 0 0 32px 0;
    font-size: {{ block.settings.text_2_font_size }}px;
    text-align: {{ block.settings.text_2_text_align }};
    {% if block.settings.text_2_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    margin-top: 32px;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background_color }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} th,
  .ai-comparison-table__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.cell_text_align }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    font-size: {{ block.settings.cell_font_size }}px;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_row_background }};
    color: {{ block.settings.header_row_text_color }};
    {% if block.settings.header_row_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_background_color }};
    color: {{ block.settings.cell_text_color }};
    {% if block.settings.cell_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tbody tr:nth-child(even) td {
    background-color: {{ block.settings.alternate_row_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table__heading-1-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_1_font_size | times: 0.8 }}px;
    }

    .ai-comparison-table__text-1-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_1_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__heading-2-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_2_font_size | times: 0.8 }}px;
    }

    .ai-comparison-table__text-2-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_2_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__table-{{ ai_gen_id }} th,
    .ai-comparison-table__table-{{ ai_gen_id }} td {
      font-size: {{ block.settings.cell_font_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table__container-{{ ai_gen_id }}">
    <div class="ai-comparison-table__content-section-{{ ai_gen_id }}">
      {% if block.settings.heading_1 != blank %}
        {% case block.settings.heading_1_tag %}
          {% when 'h1' %}
            <h1 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h1>
          {% when 'h2' %}
            <h2 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h2>
          {% when 'h3' %}
            <h3 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
          {% when 'h4' %}
            <h4 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h4>
          {% when 'h5' %}
            <h5 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h5>
          {% when 'h6' %}
            <h6 class="ai-comparison-table__heading-1-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h6>
        {% endcase %}
      {% endif %}

      {% if block.settings.text_1 != blank %}
        <div class="ai-comparison-table__text-1-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
      {% endif %}

      {% if block.settings.heading_2 != blank %}
        {% case block.settings.heading_2_tag %}
          {% when 'h1' %}
            <h1 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h1>
          {% when 'h2' %}
            <h2 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h2>
          {% when 'h3' %}
            <h3 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
          {% when 'h4' %}
            <h4 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h4>
          {% when 'h5' %}
            <h5 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h5>
          {% when 'h6' %}
            <h6 class="ai-comparison-table__heading-2-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h6>
        {% endcase %}
      {% endif %}

      {% if block.settings.text_2 != blank %}
        <div class="ai-comparison-table__text-2-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
      {% endif %}
    </div>

    <div class="ai-comparison-table__wrapper-{{ ai_gen_id }}">
      <table class="ai-comparison-table__table-{{ ai_gen_id }}">
        <thead>
          <tr>
            {% if block.settings.col_1_header != blank %}
              <th>{{ block.settings.col_1_header }}</th>
            {% endif %}
            {% if block.settings.col_2_header != blank %}
              <th>{{ block.settings.col_2_header }}</th>
            {% endif %}
            {% if block.settings.col_3_header != blank %}
              <th>{{ block.settings.col_3_header }}</th>
            {% endif %}
            {% if block.settings.col_4_header != blank %}
              <th>{{ block.settings.col_4_header }}</th>
            {% endif %}
            {% if block.settings.show_col_5 and block.settings.col_5_header != blank %}
              <th>{{ block.settings.col_5_header }}</th>
            {% endif %}
            {% if block.settings.show_col_6 and block.settings.col_6_header != blank %}
              <th>{{ block.settings.col_6_header }}</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for i in (1..12) %}
            {% liquid
              assign row_key = 'row_' | append: i | append: '_col_1'
              assign row_value = block.settings[row_key]
            %}
            {% if row_value != blank %}
              <tr>
                {% if block.settings.col_1_header != blank %}
                  <td>{{ block.settings[row_key] }}</td>
                {% endif %}
                {% if block.settings.col_2_header != blank %}
                  {% assign col_key = 'row_' | append: i | append: '_col_2' %}
                  <td>{{ block.settings[col_key] }}</td>
                {% endif %}
                {% if block.settings.col_3_header != blank %}
                  {% assign col_key = 'row_' | append: i | append: '_col_3' %}
                  <td>{{ block.settings[col_key] }}</td>
                {% endif %}
                {% if block.settings.col_4_header != blank %}
                  {% assign col_key = 'row_' | append: i | append: '_col_4' %}
                  <td>{{ block.settings[col_key] }}</td>
                {% endif %}
                {% if block.settings.show_col_5 and block.settings.col_5_header != blank %}
                  {% assign col_key = 'row_' | append: i | append: '_col_5' %}
                  <td>{{ block.settings[col_key] }}</td>
                {% endif %}
                {% if block.settings.show_col_6 and block.settings.col_6_header != blank %}
                  {% assign col_key = 'row_' | append: i | append: '_col_6' %}
                  <td>{{ block.settings[col_key] }}</td>
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

