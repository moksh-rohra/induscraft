{% doc %}
  @prompt
    Create a section with heading, sub-heading and text and a compration table  4-6 columns and 10-12 rows. Section with should be adjustable in pixels, in table there should be an option to heading, font-size, bold, not bold and all other advanced option like text allign etc
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-comparison-table-container-{{ ai_gen_id }} {
    width: {{ block.settings.section_width }}px;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-comparison-table-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_text_align }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-comparison-table-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: {% if block.settings.heading_bold %}700{% else %}400{% endif %};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
  }

  .ai-comparison-table-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    font-weight: {% if block.settings.subheading_bold %}700{% else %}400{% endif %};
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px 0;
  }

  .ai-comparison-table-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    font-weight: {% if block.settings.text_bold %}700{% else %}400{% endif %};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    margin-top: {{ block.settings.table_margin_top }}px;
  }

  .ai-comparison-table-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background_color }};
  }

  .ai-comparison-table-table-{{ ai_gen_id }} th,
  .ai-comparison-table-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    text-align: {{ block.settings.cell_text_align }};
    vertical-align: {{ block.settings.cell_vertical_align }};
  }

  .ai-comparison-table-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_row_bg_color }};
    color: {{ block.settings.header_row_text_color }};
    font-size: {{ block.settings.header_row_font_size }}px;
    font-weight: {% if block.settings.header_row_bold %}700{% else %}400{% endif %};
  }

  .ai-comparison-table-table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_bg_color }};
    color: {{ block.settings.cell_text_color }};
    font-size: {{ block.settings.cell_font_size }}px;
    font-weight: {% if block.settings.cell_bold %}700{% else %}400{% endif %};
  }

  .ai-comparison-table-table-{{ ai_gen_id }} tbody tr:nth-child(even) td {
    background-color: {{ block.settings.alternate_row_bg_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.5 }}px;
    }

    .ai-comparison-table-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.8 }}px;
    }

    .ai-comparison-table-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.8 }}px;
    }

    .ai-comparison-table-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table-container-{{ ai_gen_id }}">
    <div class="ai-comparison-table-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-comparison-table-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
