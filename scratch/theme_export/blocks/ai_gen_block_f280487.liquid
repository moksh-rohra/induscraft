{% doc %}
  @prompt
    Genrate a section which has heading, sub-heading, text option with bullet points and all. Also want 3-5 column, each column will have 2 columns, one is for the content and other is for the image. In the content I want heading, sub-heading, text option with bullet points and all, with CTA.
    
    I want adjustable section width option in pixels. also I want padding option for all, color option for size, text size option, selecting heading size like h1,h2,h3 etc., the multicolumns that I want is 1 below one, not all in one line, that will be a complete section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-column-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-multi-column-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
  }

  .ai-multi-column-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: 40px;
  }

  .ai-multi-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .ai-multi-column-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px;
  }

  .ai-multi-column-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-multi-column-text-{{ ai_gen_id }} ul {
    list-style: disc;
    padding-left: 20px;
    margin: 8px 0;
  }

  .ai-multi-column-text-{{ ai_gen_id }} li {
    margin-bottom: 4px;
  }

  .ai-multi-column-grid-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_gap }}px;
  }

  .ai-multi-column-item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-multi-column-item-content-{{ ai_gen_id }} {
    {% if block.settings.content_position == 'right' %}
      order: 2;
    {% endif %}
  }

  .ai-multi-column-item-image-{{ ai_gen_id }} {
    {% if block.settings.content_position == 'right' %}
      order: 1;
    {% endif %}
  }

  .ai-multi-column-item-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_heading_size }}px;
    color: {{ block.settings.item_heading_color }};
    margin: 0 0 12px;
  }

  .ai-multi-column-item-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_subheading_size }}px;
    color: {{ block.settings.item_subheading_color }};
    margin: 0 0 8px;
  }

  .ai-multi-column-item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.item_text_color }};
    margin: 0 0 16px;
  }

  .ai-multi-column-item-text-{{ ai_gen_id }} ul {
    list-style: disc;
    padding-left: 20px;
    margin: 8px 0;
  }

  .ai-multi-column-item-text-{{ ai_gen_id }} li {
    margin-bottom: 4px;
  }

  .ai-multi-column-item-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-multi-column-item-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-column-item-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-column-item-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-multi-column-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.cta_background_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_text_size }}px;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.cta_border_color }};
  }

  .ai-multi-column-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background_color }};
    color: {{ block.settings.cta_hover_text_color }};
    border-color: {{ block.settings.cta_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-multi-column-item-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-multi-column-item-content-{{ ai_gen_id }},
    .ai-multi-column-item-image-{{ ai_gen_id }} {
      order: unset;
    }

    .ai-multi-column-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-multi-column-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multi-column-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.text != blank %}
      <div class="ai-multi-column-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          {% if block.settings.heading_tag == 'h1' %}
            <h1 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
          {% elsif block.settings.heading_tag == 'h2' %}
            <h2 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% elsif block.settings.heading_tag == 'h3' %}
            <h3 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
          {% elsif block.settings.heading_tag == 'h4' %}
            <h4 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h4>
          {% elsif block.settings.heading_tag == 'h5' %}
            <h5 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h5>
          {% else %}
            <h6 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h6>
          {% endif %}
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-multi-column-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-multi-column-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-multi-column-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_heading_key = 'column_' | append: i | append: '_heading'
          assign column_subheading_key = 'column_' | append: i | append: '_subheading'
          assign column_text_key = 'column_' | append: i | append: '_text'
          assign column_image_key = 'column_' | append: i | append: '_image'
          assign column_cta_text_key = 'column_' | append: i | append: '_cta_text'
          assign column_cta_link_key = 'column_' | append: i | append: '_cta_link'
          assign column_heading_tag_key = 'column_' | append: i | append: '_heading_tag'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_heading = block.settings[column_heading_key]
          assign column_subheading = block.settings[column_subheading_key]
          assign column_text = block.settings[column_text_key]
          assign column_image = block.settings[column_image_key]
          assign column_cta_text = block.settings[column_cta_text_key]
          assign column_cta_link = block.settings[column_cta_link_key]
          assign column_heading_tag = block.settings[column_heading_tag_key]
        %}

        {% if column_enabled %}
          <div class="ai-multi-column-item-{{ ai_gen_id }}">
            <div class="ai-multi-column-item-content-{{ ai_gen_id }}">
              {% if column_heading != blank %}
                {% if column_heading_tag == 'h1' %}
                  <h1 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h1>
                {% elsif column_heading_tag == 'h2' %}
                  <h2 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h2>
                {% elsif column_heading_tag == 'h3' %}
                  <h3 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
                {% elsif column_heading_tag == 'h4' %}
                  <h4 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h4>
                {% elsif column_heading_tag == 'h5' %}
                  <h5 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h5>
                {% else %}
                  <h6 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h6>
                {% endif %}
              {% endif %}

              {% if column_subheading != blank %}
                <div class="ai-multi-column-item-subheading-{{ ai_gen_id }}">{{ column_subheading }}</div>
              {% endif %}

              {% if column_text != blank %}
                <div class="ai-multi-column-item-text-{{ ai_gen_id }}">{{ column_text }}</div>
              {% endif %}

              {% if column_cta_text != blank and column_cta_link != blank %}
                <a href="{{ column_cta_link }}" class="ai-multi-column-cta-{{ ai_gen_id }}">
                  {{ column_cta_text }}
                </a>
              {% endif %}
            </div>

            <div class="ai-multi-column-item-image-{{ ai_gen_id }}">
              <div class="ai-multi-column-item-image-wrapper-{{ ai_gen_id }}">
                {% if column_image %}
                  <img
                    src="{{ column_image | image_url: width: 800 }}"
                    alt="{{ column_image.alt | escape }}"
                    loading="lazy"
                    width="{{ column_image.width }}"
                    height="{{ column_image.height }}"
                  >
                {% else %}
                  <div class="ai-multi-column-item-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

