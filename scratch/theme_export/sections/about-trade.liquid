{%- comment -%}
  ============================================
  About Trade Section
  ============================================
  Two-column layout:
  LEFT:  Subheading + Heading + Tag pills
  RIGHT: Image + CTA Button (theme button-new)
  ============================================
{%- endcomment -%}

{{ 'about-trade.css' | asset_url | stylesheet_tag }}

{% style %}
  #AboutTrade-{{ section.id }} {
    /* Background & Spacing */
    --about-trade-bg: {{ section.settings.background_color }};
    --about-trade-pad-top: {{ section.settings.padding_top }}px;
    --about-trade-pad-bottom: {{ section.settings.padding_bottom }}px;
    --about-trade-pad-x: {{ section.settings.padding_x }}px;
    --about-trade-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --about-trade-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --about-trade-pad-x-m: {{ section.settings.padding_x_mobile }}px;

    /* Grid */
    --about-trade-left-w: {{ section.settings.left_column_width }}%;
    --about-trade-gap: {{ section.settings.columns_gap }}px;
    --about-trade-gap-mobile: {{ section.settings.columns_gap_mobile }}px;

    /* Typography */
    --about-trade-heading-size: {{ section.settings.heading_size_desktop }}px;
    --about-trade-heading-size-t: {{ section.settings.heading_size_desktop | times: 0.8 | round }}px;
    --about-trade-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --about-trade-subheading-size: {{ section.settings.subheading_size }}px;
    --about-trade-heading-max-w: {{ section.settings.heading_max_width }}px;

    /* Colors */
    --about-trade-heading-color: {{ section.settings.heading_color }};
    --about-trade-subheading-color: {{ section.settings.subheading_color }};
    --about-trade-tag-color: {{ section.settings.tag_text_color }};
    --about-trade-tag-border: {{ section.settings.tag_border_color }};

    /* Image */
    --about-trade-img-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Heading size override for specificity */
  #AboutTrade-{{ section.id }} .about-trade__heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
  }
  @media (max-width: 991px) {
    #AboutTrade-{{ section.id }} .about-trade__heading {
      font-size: {{ section.settings.heading_size_desktop | times: 0.8 | round }}px;
    }
  }
  @media (max-width: 749px) {
    #AboutTrade-{{ section.id }} .about-trade__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }
{% endstyle %}

<section
  id="AboutTrade-{{ section.id }}"
  class="about-trade"
  data-section-id="{{ section.id }}"
>
  <div class="about-trade__grid">

    {%- comment -%} ── LEFT COLUMN ── {%- endcomment -%}
    <div class="about-trade__left">

      {%- if section.settings.subheading != blank -%}
        <p class="about-trade__subheading about-trade__animate">
          <span class="about-trade__label-icon"></span>
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="about-trade__heading about-trade__animate">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="about-trade__tags about-trade__animate">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tag' and block.settings.label != blank -%}
              <span class="about-trade__tag" {{ block.shopify_attributes }}>
                {{ block.settings.label | escape }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ── RIGHT COLUMN ── {%- endcomment -%}
    <div class="about-trade__right">

      {%- if section.settings.video != blank -%}
        <div class="about-trade__image-wrapper about-trade__animate">
          {{ section.settings.video | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            class: 'about-trade__image'
          }}
        </div>
      {%- elsif section.settings.image != blank -%}
        <div class="about-trade__image-wrapper about-trade__animate">
          {{ section.settings.image | image_url: width: 1500 | image_tag:
            loading: 'lazy',
            class: 'about-trade__image',
            widths: '375, 550, 750, 1100, 1500',
            sizes: '(max-width: 749px) 100vw, 45vw'
          }}
        </div>
      {%- else -%}
        <div class="about-trade__image-wrapper about-trade__animate" style="aspect-ratio:16/9;background:#e9e9e9;"></div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div class="about-trade__cta about-trade__animate">
          <a
            href="{{ section.settings.button_link }}"
            class="button-new button--{{ section.settings.button_style }} focus-visible-outline"
            aria-label="{{ section.settings.button_text | escape }}"
          >
            {{ section.settings.button_text | escape }}
          </a>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

{%- comment -%} ── GSAP Stagger Animation ── {%- endcomment -%}
<script>
  (function () {
    const sectionId = '{{ section.id }}';

    function initAboutTradeAnimation() {
      if (typeof gsap === 'undefined') {
        setTimeout(initAboutTradeAnimation, 100);
        return;
      }

      const section = document.querySelector(`#AboutTrade-${sectionId}`);
      if (!section) return;

      const elements = section.querySelectorAll('.about-trade__animate');

      gsap.set(elements, { clearProps: 'transform,opacity' });

      gsap.fromTo(
        elements,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.9,
          stagger: 0.12,
          ease: 'power3.out',
          delay: 0.2,
          scrollTrigger: {
            trigger: section,
            start: 'top 85%',
          }
        }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutTradeAnimation);
    } else {
      initAboutTradeAnimation();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) {
        initAboutTradeAnimation();
      }
    });
  })();
</script>

{% schema %}
