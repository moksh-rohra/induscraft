{{ 'b2b-testimonials.css' | asset_url | stylesheet_tag }}

<section
  id="b2b-testimonials-{{ section.id }}"
  class="b2b-testimonials"
  data-section-id="{{ section.id }}"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --subheading-color: {{ section.settings.subheading_color }};
    --subheading-size-d: {{ section.settings.subheading_size_d }}px;
    --subheading-size-m: {{ section.settings.subheading_size_m }}px;
    --heading-color: {{ section.settings.heading_color }};
    --heading-size-d: {{ section.settings.heading_size_d }}px;
    --heading-size-m: {{ section.settings.heading_size_m }}px;
    --testimony-color: {{ section.settings.testimony_color }};
    --testimony-size-d: {{ section.settings.testimony_size_d }}px;
    --testimony-size-m: {{ section.settings.testimony_size_m }}px;
    --author-name-color: {{ section.settings.author_name_color }};
    --author-name-size: {{ section.settings.author_name_size }}px;
    --author-role-color: {{ section.settings.author_role_color }};
    --author-role-size: {{ section.settings.author_role_size }}px;
    --quote-icon-color: {{ section.settings.quote_icon_color }};
    --quote-icon-size: {{ section.settings.quote_icon_size }}px;
    --nav-btn-border-color: {{ section.settings.nav_btn_border_color }};
    --nav-btn-bg: {{ section.settings.nav_btn_bg }};
    --nav-btn-hover-bg: {{ section.settings.nav_btn_hover_bg }};
    --nav-btn-icon-color: {{ section.settings.nav_btn_icon_color }};
    --nav-btn-hover-icon-color: {{ section.settings.nav_btn_hover_icon_color }};
    --nav-btn-size: {{ section.settings.nav_btn_size }}px;
    --counter-color: {{ section.settings.counter_color }};
    --media-width-d: {{ section.settings.media_width_d }}%;
    --media-max-height: {{ section.settings.media_max_height }}px;
    --media-border-radius: {{ section.settings.media_border_radius }}px;
    --media-aspect-ratio: {{ section.settings.media_aspect_ratio }};
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};
    --star-color: {{ section.settings.star_color }};

    --pt-d: {{ section.settings.padding_top_d }}px;
    --pb-d: {{ section.settings.padding_bottom_d }}px;
    --pl-d: {{ section.settings.padding_left_d }}px;
    --pr-d: {{ section.settings.padding_right_d }}px;
    --mt-d: {{ section.settings.margin_top_d }}px;
    --mb-d: {{ section.settings.margin_bottom_d }}px;
    --ml-d: {{ section.settings.margin_left_d }}px;
    --mr-d: {{ section.settings.margin_right_d }}px;

    --pt-m: {{ section.settings.padding_top_m }}px;
    --pb-m: {{ section.settings.padding_bottom_m }}px;
    --pl-m: {{ section.settings.padding_left_m }}px;
    --pr-m: {{ section.settings.padding_right_m }}px;
    --mt-m: {{ section.settings.margin_top_m }}px;
    --mb-m: {{ section.settings.margin_bottom_m }}px;
    --ml-m: {{ section.settings.margin_left_m }}px;
    --mr-m: {{ section.settings.margin_right_m }}px;
  "
>
  <div class="b2b-testimonials__container">

    {%- assign total_blocks = section.blocks.size -%}

    <!-- Body: Left text + Right media -->
    <div class="b2b-testimonials__body">

      <!-- Left: Header + Testimonial Content -->
      <div class="b2b-testimonials__left">

        <!-- Header -->
        <div class="b2b-testimonials__header">
          <div class="b2b-testimonials__subheading-wrapper">
            <div class="b2b-testimonials__icon"></div>
            <span class="b2b-testimonials__subheading">{{ section.settings.subheading }}</span>
          </div>
          {%- if section.settings.heading != blank -%}
            <h2 class="b2b-testimonials__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>

        {%- if section.settings.show_quote_icon -%}
          <div class="b2b-testimonials__quote-icon">
            <svg viewBox="0 0 56 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path style="fill: {{ section.settings.quote_icon_color }};" d="M0 40V27.2C0 23.467 0.667 19.867 2 16.4C3.38 12.933 5.333 9.867 7.86 7.2C10.433 4.533 13.427 2.4 16.84 0.8L21.56 5.92C18.24 7.893 15.573 10.333 13.56 13.24C11.593 16.147 10.42 19.36 10.04 22.88H22.12V40H0ZM33.88 40V27.2C33.88 23.467 34.547 19.867 35.88 16.4C37.26 12.933 39.213 9.867 41.74 7.2C44.313 4.533 47.307 2.4 50.72 0.8L55.44 5.92C52.12 7.893 49.453 10.333 47.44 13.24C45.473 16.147 44.3 19.36 43.92 22.88H56V40H33.88Z"/>
            </svg>
          </div>
        {%- endif -%}

        {%- if total_blocks > 0 -%}
          <div class="b2b-testimonials__slides" data-testimonial-count="{{ total_blocks }}">
            {%- for block in section.blocks -%}
              <div
                class="b2b-testimonials__slide{% if forloop.first %} is-active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {%- if section.settings.show_rating -%}
                  <div class="b2b-testimonials__rating">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 14 14">
                          <path style="fill: {{ section.settings.star_color }};" d="M11.2041 13.4847C11.2854 13.5324 11.3856 13.4614 11.364 13.3711L10.2665 8.76271C10.2575 8.72485 10.2707 8.68522 10.3008 8.65975L13.9628 5.56053C14.0345 5.49985 13.9962 5.3848 13.9017 5.37688L9.07419 4.97235C9.03456 4.96903 9.00007 4.94458 8.98455 4.90882L7.09882 0.56391C7.06184 0.478697 6.93818 0.478697 6.9012 0.56391L5.01547 4.90882C4.99995 4.94458 4.96545 4.96903 4.92583 4.97235L0.0982952 5.37688C0.00376339 5.3848 -0.034516 5.49985 0.0371876 5.56053L3.69925 8.65975C3.72934 8.68522 3.74253 8.72485 3.7335 8.76271L2.63591 13.3711C2.61442 13.4614 2.71463 13.5324 2.79589 13.4847L6.94457 11.0405C6.97866 11.0204 7.02134 11.0204 7.05544 11.0405L11.2041 13.4847Z"/>
                        </svg>
                      {%- else -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 14 14">
                          <path style="fill: none; stroke: {{ section.settings.star_color }}; stroke-width: 0.8;" d="M11.2041 13.4847C11.2854 13.5324 11.3856 13.4614 11.364 13.3711L10.2665 8.76271C10.2575 8.72485 10.2707 8.68522 10.3008 8.65975L13.9628 5.56053C14.0345 5.49985 13.9962 5.3848 13.9017 5.37688L9.07419 4.97235C9.03456 4.96903 9.00007 4.94458 8.98455 4.90882L7.09882 0.56391C7.06184 0.478697 6.93818 0.478697 6.9012 0.56391L5.01547 4.90882C4.99995 4.94458 4.96545 4.96903 4.92583 4.97235L0.0982952 5.37688C0.00376339 5.3848 -0.034516 5.49985 0.0371876 5.56053L3.69925 8.65975C3.72934 8.68522 3.74253 8.72485 3.7335 8.76271L2.63591 13.3711C2.61442 13.4614 2.71463 13.5324 2.79589 13.4847L6.94457 11.0405C6.97866 11.0204 7.02134 11.0204 7.05544 11.0405L11.2041 13.4847Z"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <p class="b2b-testimonials__testimony">{{ block.settings.testimony }}</p>

                <div class="b2b-testimonials__author">
                  {%- if block.settings.author_name != blank -%}
                    <p class="b2b-testimonials__author-name">{{ block.settings.author_name }}</p>
                  {%- endif -%}
                  {%- if block.settings.author_role != blank -%}
                    <p class="b2b-testimonials__author-role">{{ block.settings.author_role }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="b2b-testimonials__slides">
            <div class="b2b-testimonials__slide is-active">
              <p class="b2b-testimonials__testimony">Add testimonial blocks to display reviews here.</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Right: Media Slider -->
      <div class="b2b-testimonials__right">
        {%- if total_blocks > 0 -%}
          <div class="b2b-testimonials__media-wrapper">
            <div class="b2b-testimonials__media-slider">
              <div class="b2b-testimonials__media-track" data-media-count="{{ total_blocks }}">
                {%- for block in section.blocks -%}
                  <div
                    class="b2b-testimonials__media-slide"
                    data-media-index="{{ forloop.index0 }}"
                    data-media-type="{{ block.settings.media_type }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.media_type == 'image' -%}
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 1200 | image_tag:
                          loading: 'lazy',
                          class: 'b2b-testimonials__media-img',
                          widths: '400, 600, 800, 1200',
                          sizes: '(min-width: 768px) 45vw, 100vw'
                        }}
                      {%- else -%}
                        <div class="b2b-testimonials__media-placeholder">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                          </svg>
                          <span>Add an image</span>
                        </div>
                      {%- endif -%}

                    {%- elsif block.settings.media_type == 'video' -%}
                      {%- if block.settings.video != blank -%}
                        <div class="b2b-testimonials__video-container">
                          {{ block.settings.video | video_tag:
                            autoplay: false,
                            loop: true,
                            muted: true,
                            playsinline: true,
                            class: 'b2b-testimonials__video',
                            preload: 'metadata',
                            image_size: '800x'
                          }}
                          <button class="b2b-testimonials__video-play" aria-label="Play/Pause video">
                            <svg class="b2b-test-icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                            <svg class="b2b-test-icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                            </svg>
                          </button>
                          <button class="b2b-testimonials__video-mute" aria-label="Mute/Unmute video">
                            <svg class="b2b-test-icon-muted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                            </svg>
                            <svg class="b2b-test-icon-unmuted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                            </svg>
                          </button>
                        </div>
                      {%- elsif block.settings.video_url != blank -%}
                        <div class="b2b-testimonials__video-container">
                          {%- if block.settings.video_url.type == 'youtube' -%}
                            <iframe
                              class="b2b-testimonials__iframe"
                              src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?enablejsapi=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&playsinline=1"
                              frameborder="0"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                            ></iframe>
                          {%- elsif block.settings.video_url.type == 'vimeo' -%}
                            <iframe
                              class="b2b-testimonials__iframe"
                              src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?muted=1&loop=1&autopause=0"
                              frameborder="0"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                            ></iframe>
                          {%- endif -%}
                        </div>
                      {%- else -%}
                        <div class="b2b-testimonials__media-placeholder">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z"/>
                          </svg>
                          <span>Add a video</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>

            {%- if section.settings.show_dots and total_blocks > 1 -%}
              <div class="b2b-testimonials__dots">
                {%- for block in section.blocks -%}
                  <button
                    class="b2b-testimonials__dot{% if forloop.first %} is-active{% endif %}"
                    aria-label="Go to slide {{ forloop.index }}"
                    data-dot-index="{{ forloop.index0 }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <!-- Navigation Arrows (below media) -->
          {%- if total_blocks > 1 -%}
            <div class="b2b-testimonials__nav">
              <button class="b2b-testimonials__nav-btn" data-dir="prev" aria-label="Previous testimonial">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <span class="b2b-testimonials__counter">
                <span class="b2b-testimonials__counter-current">01</span>
                <span> / </span>
                <span class="b2b-testimonials__counter-total">{{ total_blocks | prepend: '0' | slice: -2, 2 }}</span>
              </span>
              <button class="b2b-testimonials__nav-btn" data-dir="next" aria-label="Next testimonial">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="b2b-testimonials__media-wrapper">
            <div class="b2b-testimonials__media-slider">
              <div class="b2b-testimonials__media-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                </svg>
                <span>Add testimonial blocks</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById(`b2b-testimonials-${sectionId}`);
  if (!section) return;

  const slides = section.querySelectorAll('.b2b-testimonials__slide');
  const mediaTrack = section.querySelector('.b2b-testimonials__media-track');
  const mediaSlides = section.querySelectorAll('.b2b-testimonials__media-slide');
  const dots = section.querySelectorAll('.b2b-testimonials__dot');
  const prevBtn = section.querySelector('[data-dir="prev"]');
  const nextBtn = section.querySelector('[data-dir="next"]');
  const counterCurrent = section.querySelector('.b2b-testimonials__counter-current');

  const totalSlides = Math.max(slides.length, mediaSlides.length);
  let currentIndex = 0;
  let isAnimating = false;

  function goTo(index) {
    if (isAnimating || totalSlides <= 1) return;
    isAnimating = true;

    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;

    // Update testimonial text slides
    slides.forEach((s, i) => {
      s.classList.toggle('is-active', i === index);
    });

    // Update media slider
    if (mediaTrack) {
      mediaTrack.style.transform = `translateX(-${index * 100}%)`;
      pauseAllMedia();
    }

    // Update dots
    dots.forEach((d, i) => {
      d.classList.toggle('is-active', i === index);
    });

    // Update counter
    if (counterCurrent) {
      counterCurrent.textContent = String(index + 1).padStart(2, '0');
    }

    currentIndex = index;

    setTimeout(() => {
      isAnimating = false;
    }, 550);
  }

  function pauseAllMedia() {
    section.querySelectorAll('.b2b-testimonials__video').forEach(video => {
      if (!video.paused) video.pause();
    });
    section.querySelectorAll('.b2b-testimonials__video-play').forEach(btn => {
      btn.classList.remove('is-playing');
    });
  }

  if (prevBtn) prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => goTo(currentIndex + 1));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      goTo(parseInt(dot.dataset.dotIndex, 10));
    });
  });

  // Video Play/Pause
  section.querySelectorAll('.b2b-testimonials__video-play').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const container = btn.closest('.b2b-testimonials__video-container');
      const video = container ? container.querySelector('video') : null;
      if (!video) return;

      if (video.paused) {
        pauseAllMedia();
        video.play();
        btn.classList.add('is-playing');
      } else {
        video.pause();
        btn.classList.remove('is-playing');
      }
    });
  });

  // Video Mute/Unmute
  section.querySelectorAll('.b2b-testimonials__video-mute').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const container = btn.closest('.b2b-testimonials__video-container');
      const video = container ? container.querySelector('video') : null;
      if (!video) return;

      video.muted = !video.muted;
      btn.classList.toggle('is-unmuted', !video.muted);
    });
  });

  // Drag & Swipe support (mouse + touch)
  const mediaSlider = section.querySelector('.b2b-testimonials__media-slider');
  if (mediaSlider && totalSlides > 1) {
    let isDragging = false;
    let startX = 0;
    let dragDelta = 0;
    let sliderWidth = 0;

    function onDragStart(x) {
      isDragging = true;
      startX = x;
      dragDelta = 0;
      sliderWidth = mediaSlider.offsetWidth;
      mediaTrack.style.transition = 'none';
      mediaSlider.style.cursor = 'grabbing';
    }

    function onDragMove(x) {
      if (!isDragging) return;
      dragDelta = x - startX;
      const baseOffset = -currentIndex * 100;
      const dragPercent = (dragDelta / sliderWidth) * 100;
      mediaTrack.style.transform = `translateX(${baseOffset + dragPercent}%)`;
    }

    function onDragEnd() {
      if (!isDragging) return;
      isDragging = false;
      mediaTrack.style.transition = '';
      mediaSlider.style.cursor = '';

      const threshold = sliderWidth * 0.15; // 15% of width to trigger slide
      if (Math.abs(dragDelta) > threshold) {
        goTo(currentIndex + (dragDelta < 0 ? 1 : -1));
      } else {
        // Snap back
        mediaTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      dragDelta = 0;
    }

    // Mouse events
    mediaSlider.addEventListener('mousedown', (e) => {
      if (e.target.closest('.b2b-testimonials__video-play')) return;
      e.preventDefault();
      onDragStart(e.clientX);
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      onDragMove(e.clientX);
    });

    document.addEventListener('mouseup', () => {
      onDragEnd();
    });

    // Touch events
    mediaSlider.addEventListener('touchstart', (e) => {
      if (e.target.closest('.b2b-testimonials__video-play')) return;
      onDragStart(e.touches[0].clientX);
    }, { passive: true });

    mediaSlider.addEventListener('touchmove', (e) => {
      onDragMove(e.touches[0].clientX);
    }, { passive: true });

    mediaSlider.addEventListener('touchend', () => {
      onDragEnd();
    }, { passive: true });

    // Prevent accidental link clicks after drag
    mediaSlider.addEventListener('click', (e) => {
      if (Math.abs(dragDelta) > 5) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    // Set grab cursor
    mediaSlider.style.cursor = 'grab';
  }

  // Keyboard
  section.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') goTo(currentIndex - 1);
    if (e.key === 'ArrowRight') goTo(currentIndex + 1);
  });
})();
</script>

{% schema %}
{
  "name": "B2B Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "TESTIMONIALS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What our partners say about working with us"
    },
    {
      "type": "header",
      "content": "Typography — Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size_d",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "subheading_size_m",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Mobile)",
      "default": 11
    },
