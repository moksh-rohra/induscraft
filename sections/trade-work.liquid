    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image",
          "info": "Shown on the left when this step is active."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Describe this step of your process here.</p>"
        },
        {
          "type": "text",
          "id": "custom_number",
          "label": "Custom Number",
          "info": "Leave blank to auto-number (01, 02…)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade Work",
      "settings": {
        "subheading": "(03)",
        "section_label": "Our Process",
        "left_description": "<p>A clear and collaborative approach — from vision to execution.</p>",
        "background_color": "#ffffff",
        "heading_color": "#1a1a1a",
        "subheading_color": "#888888",
        "description_color": "#666666"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Share Your Requirements",
            "description": "<p>Tell us about your project — the spaces, styles, and quantities you need. We take the time to listen, understand your goals, and identify the right product lines for your vision. We offer early insight, identify opportunities, and set the tone for the collaboration ahead.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Get B2B Pricing",
            "description": "<p>For projects above ₹5 lakh, unlock exclusive trade pricing with volume discounts. We offer tiered pricing slabs based on quantity, project scope, and partnership level — giving you the margin you need to grow your business.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Design & Customisation",
            "description": "<p>Your vision becomes tangible form. Our team works with you on material selection, finishes, and dimensions. We refine layout, flow, and relationships — forming a clear framework for every future decision.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Production & Delivery",
            "description": "<p>The design takes form through detailed production. Furniture, lighting, built-ins, and finishes are handcrafted by our artisans in Jodhpur. Quality-checked and delivered to your site with full logistics support across India — both technically and with care.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
