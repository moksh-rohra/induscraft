{%- comment -%}
  ============================================
  Trade Hero Section
  ============================================
  Full-screen background image/video with
  split two-column content layout:
  LEFT:  Subheading + Heading
  RIGHT: Description + Two Buttons
  
  Features:
  - Background image with separate mobile image
  - Background video (Shopify-hosted)
  - Adjustable dark overlay
  - Two-column split layout with full position controls
  - GSAP stagger-in animation
  - Fully customizable via Theme Editor
  ============================================
{%- endcomment -%}

{{ 'trade-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_height_class = 'trade-hero--' | append: section.settings.section_height
-%}

{% style %}
  #TradeHero-{{ section.id }} {
    /* Background */
    --trade-hero-bg-color: {{ section.settings.bg_fallback_color }};
    --trade-hero-height-mobile: {{ section.settings.mobile_height }}vh;

    /* Grid */
    --trade-hero-left-width: {{ section.settings.left_column_width }}%;
    --trade-hero-right-width: {{ section.settings.right_column_width }}%;
    --trade-hero-columns-gap: {{ section.settings.columns_gap }}px;
    --trade-hero-columns-gap-mobile: {{ section.settings.columns_gap_mobile }}px;

    /* Padding Desktop */
    --trade-hero-pad-top: {{ section.settings.padding_top_desktop }}px;
    --trade-hero-pad-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --trade-hero-pad-left: {{ section.settings.padding_left_desktop }}px;
    --trade-hero-pad-right: {{ section.settings.padding_right_desktop }}px;

    /* Padding Mobile */
    --trade-hero-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --trade-hero-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --trade-hero-pad-left-m: {{ section.settings.padding_left_mobile }}px;
    --trade-hero-pad-right-m: {{ section.settings.padding_right_mobile }}px;

    /* Typography */
    --trade-hero-heading-color: {{ section.settings.heading_color }};
    --trade-hero-subheading-color: {{ section.settings.subheading_color }};
    --trade-hero-desc-color: {{ section.settings.description_color }};
    --trade-hero-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --trade-hero-heading-size-t: {{ section.settings.heading_size_desktop | times: 0.8 | round }}px;
    --trade-hero-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --trade-hero-subheading-size-d: {{ section.settings.subheading_size_desktop }}px;
    --trade-hero-subheading-size-m: {{ section.settings.subheading_size_mobile }}px;
    --trade-hero-desc-size-d: {{ section.settings.description_size_desktop }}px;
    --trade-hero-desc-size-m: {{ section.settings.description_size_mobile }}px;
    --trade-hero-desc-max-width: {{ section.settings.description_max_width }}px;
  }

  /* Override theme global heading styles (e.g. .design-alternate h1) */
  #TradeHero-{{ section.id }} .trade-hero__heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
  }
  #TradeHero-{{ section.id }} .trade-hero__subheading {
    font-size: {{ section.settings.subheading_size_desktop }}px;
  }
  #TradeHero-{{ section.id }} .trade-hero__description {
    font-size: {{ section.settings.description_size_desktop }}px;
    max-width: {{ section.settings.description_max_width }}px;
  }

  @media (max-width: 991px) {
    #TradeHero-{{ section.id }} .trade-hero__heading {
      font-size: {{ section.settings.heading_size_desktop | times: 0.8 | round }}px;
    }
  }

  @media (max-width: 749px) {
    #TradeHero-{{ section.id }} .trade-hero__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    #TradeHero-{{ section.id }} .trade-hero__subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }
    #TradeHero-{{ section.id }} .trade-hero__description {
      font-size: {{ section.settings.description_size_mobile }}px;
    }
  }
{% endstyle %}

<section
  id="TradeHero-{{ section.id }}"
  class="trade-hero {{ section_height_class }}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ── Inner content container for parallax animation ── {%- endcomment -%}
  <div class="trade-hero__inner" id="TradeHeroContent-{{ section.id }}">
  {%- comment -%} ── Background Media ── {%- endcomment -%}
  <div class="trade-hero__media">
    {%- if section.settings.bg_video != blank -%}
      {{ section.settings.bg_video | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        class: 'trade-hero__bg-video'
      }}
    {%- elsif section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 3840 | image_tag:
        loading: 'eager',
        class: 'trade-hero__bg-image trade-hero__bg-image--desktop',
        widths: '375, 750, 1100, 1500, 2000, 3000, 3840',
        sizes: '100vw'
      }}
      {%- if section.settings.bg_image_mobile != blank -%}
        {{ section.settings.bg_image_mobile | image_url: width: 1500 | image_tag:
          loading: 'eager',
          class: 'trade-hero__bg-image trade-hero__bg-image--mobile',
          widths: '375, 550, 750, 1100, 1500',
          sizes: '100vw'
        }}
      {%- endif -%}
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg, #2A2420 0%, #3d3530 50%, #1a1a1a 100%);"></div>
    {%- endif -%}
  </div>

  {%- comment -%} ── Overlay ── {%- endcomment -%}
  {%- if section.settings.overlay_opacity > 0 -%}
    <div
      class="trade-hero__overlay"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>
  {%- endif -%}

  {%- comment -%} ── Content Grid ── {%- endcomment -%}
  <div class="trade-hero__grid trade-hero__grid--v-{{ section.settings.content_vertical_position }} trade-hero__grid--h-{{ section.settings.content_horizontal_position }}">

    {%- comment -%} ── LEFT COLUMN: Subheading + Heading ── {%- endcomment -%}
    <div class="trade-hero__col trade-hero__col--left trade-hero__col--align-{{ section.settings.left_text_align }} trade-hero__col--v-{{ section.settings.left_vertical_align }}">
      {%- if section.settings.subheading != blank -%}
        <p class="trade-hero__subheading trade-hero__animate">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="trade-hero__heading trade-hero__animate">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}
    </div>

    {%- comment -%} ── RIGHT COLUMN: Description + Buttons ── {%- endcomment -%}
    <div class="trade-hero__col trade-hero__col--right trade-hero__col--align-{{ section.settings.right_text_align }} trade-hero__col--v-{{ section.settings.right_vertical_align }}">
      {%- if section.settings.description != blank -%}
        <div class="trade-hero__description trade-hero__animate">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.button1_text != blank or section.settings.button2_text != blank -%}
        <div class="trade-hero__buttons trade-hero__animate trade-hero__buttons--{{ section.settings.buttons_alignment }}">
          {%- if section.settings.button1_text != blank -%}
            <a
              href="{{ section.settings.button1_link }}"
              class="button-new button--{{ section.settings.button1_style }} focus-visible-outline"
              aria-label="{{ section.settings.button1_text | escape }}"
            >
              {{ section.settings.button1_text | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.button2_text != blank -%}
            <a
              href="{{ section.settings.button2_link }}"
              class="button-new button--{{ section.settings.button2_style }} focus-visible-outline"
              aria-label="{{ section.settings.button2_text | escape }}"
            >
              {{ section.settings.button2_text | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
  </div>{%- comment -%} /.trade-hero__inner {%- endcomment -%}
</section>

{%- comment -%} Spacer: occupies hero height in flow so content below scrolls naturally {%- endcomment -%}
<div class="trade-hero__spacer" id="TradeHeroSpacer-{{ section.id }}"></div>
{%- comment -%} ── GSAP + ScrollTrigger ── {%- endcomment -%}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script>
  (function () {
    const sectionId = '{{ section.id }}';

    function initTradeHeroAnimation() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initTradeHeroAnimation, 100);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      const heroContent = document.querySelector(`#TradeHeroContent-${sectionId}`);
      const spacer = document.querySelector(`#TradeHeroSpacer-${sectionId}`);
      if (!heroContent || !spacer) return;

      const elements = heroContent.querySelectorAll('.trade-hero__animate');

      // ── Entrance stagger animation ──
      gsap.set(elements, { clearProps: 'transform,opacity' });
      gsap.fromTo(
        elements,
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 1,
          stagger: 0.15,
          ease: 'power3.out',
          delay: 0.3,
        }
      );

      // ── Scroll-over parallax: blur + scale + fade ──
      ScrollTrigger.getAll().forEach(function (st) {
        if (st.vars && st.vars.trigger === spacer) st.kill();
      });

      // Start slightly oversized (1.03) so blur fringing is outside the
      // parent's overflow:hidden boundary — prevents dark edge marks.
      gsap.set(heroContent, { scale: 1.03 });
      gsap.fromTo(heroContent,
        { scale: 1.03 },
        {
          scale: 0.9,
          filter: 'blur(12px)',
          opacity: 0.3,
          ease: 'none',
          scrollTrigger: {
            trigger: spacer,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTradeHeroAnimation);
    } else {
      initTradeHeroAnimation();
    }

    // Shopify Editor reload support
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) {
        ScrollTrigger.refresh();
        initTradeHeroAnimation();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Trade Hero",
  "tag": "section",
  "class": "trade-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Optional. Uses desktop image on mobile if not set."
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background Video",
      "info": "Video takes priority over images. Upload via Shopify Files."
    },
    {
      "type": "color",
      "id": "bg_fallback_color",
      "label": "Fallback Background Color",
      "default": "#1a1a1a",
      "info": "Visible while media loads or if none is set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Darkness",
      "default": 35,
      "info": "Darkens background for text readability."
    },

    {
      "type": "header",
      "content": "── Left Column ──"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CRAFTED WITH HERITAGE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless Furniture for Modern Living"
    },
    {
      "type": "select",
      "id": "left_text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
